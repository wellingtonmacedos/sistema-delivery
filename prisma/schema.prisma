generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilEstabelecimento {
  LANCHONETE
  ACAITERIA
  PIZZARIA
  DISTRIBUIDORA
}

enum TemaChat {
  PADRAO
  DARK
  MODERNO
  MINIMAL
}

enum BordaBalao {
  ARREDONDADO
  MEDIO
  RETO
}

enum Role {
  SUPER_ADMIN
  ADMIN_ESTABELECIMENTO
}

model Estabelecimento {
  id        String               @id @default(cuid())
  nome      String
  slug      String               @unique
  perfil    PerfilEstabelecimento
  ativo     Boolean              @default(true)
  logoUrl   String?
  corPrimaria   String           @default("#22c55e")
  corBot        String           @default("#f3f4f6")
  corTexto      String           @default("#111827")
  corFundoChat  String           @default("#f9fafb")
  nomeBot          String        @default("Atendimento")
  mensagemBoasVindas String? 
  avatarBotUrl     String?
  temaChat         TemaChat      @default(PADRAO)
  bordaBaloes      BordaBalao    @default(ARREDONDADO)
  sombraBaloes     Boolean       @default(false)
  descricao     String?
  telefone      String?
  endereco      Json?
  horarioAbertura   String?
  horarioFechamento String?
  diasAtivos    Json?
  taxaEntregaPadrao Decimal?     @db.Decimal(10, 2)
  permitirRetirada Boolean       @default(true)
  aberto        Boolean          @default(true)
  raioAtendimentoKm Decimal?     @db.Decimal(10, 2)
  tempoEntregaMinutos Int?
  valorMinimoPedido Decimal?     @db.Decimal(10, 2)
  entregaHabilitada Boolean      @default(true)
  produtos  Produto[]
  pedidos   Pedido[]
  clientes  Cliente[]
  admins    AdminUser[]
  configuracaoAcaiteria ConfiguracaoAcaiteria?
  acaiSabores           AcaiSabor[]
  acaiSorvetes          AcaiSorvete[]
  acaiAcompanhamentos   AcaiAcompanhamento[]
  acaiCoberturas        AcaiCobertura[]
  acaiComplementos      AcaiComplemento[]
  configuracaoPizzaria  ConfiguracaoPizzaria?
  pizzaTamanhos         PizzaTamanho[]
  pizzaSabores          PizzaSabor[]
  categorias            Categoria[]
  combos                Combo[]
  cupons                Cupom[]
  createdAt DateTime             @default(now())
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String   @unique
  enderecos Json?
  pedidos   Pedido[]
  cuponsUsos CupomUso[]
  createdAt DateTime @default(now())
  estabelecimentoId String?
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
}

model Produto {
  id         String      @id @default(cuid())
  categoria  String
  nome       String
  descricao  String?
  fotoUrl    String?
  preco      Decimal     @db.Decimal(10, 2)
  adicionais Json?
  destaque   Boolean     @default(false)
  promocaoAtiva      Boolean    @default(false)
  precoPromocional   Decimal?   @db.Decimal(10, 2)
  controlarEstoque   Boolean    @default(false)
  estoque            Int?
  tempoPreparoMinutos Int?
  ativo      Boolean     @default(true)
  ordemExibicao Int? 
  dataInicioPromocao DateTime?
  dataFimPromocao    DateTime?
  horarioInicio      String?
  horarioFim         String?
  marca             String?
  unidade           String?
  qtdPorEmbalagem   Int?
  precoEmbalagem    Decimal?   @db.Decimal(10, 2)

  // Limites específicos por produto (Açaiteria)
  maxSabores         Int?
  maxSorvetes        Int?
  maxAcompanhamentos Int?
  maxCoberturas      Int?

  itens      ItemPedido[]
  combosItens ComboItem[]
  createdAt  DateTime    @default(now())
  estabelecimentoId String?
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
  categoriaId       String?
  categoriaRef      Categoria? @relation(fields: [categoriaId], references: [id])
  variacoes         Variacao[]
  adicionaisRef     Adicional[]
}

model Categoria {
  id              String   @id @default(cuid())
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  nome            String
  icone           String?
  imagemUrl       String?
  ordemExibicao   Int? 
  ativo           Boolean  @default(true)
  produtos        Produto[]
  createdAt       DateTime @default(now())
}

model Variacao {
  id          String   @id @default(cuid())
  produtoId   String
  produto     Produto  @relation(fields: [produtoId], references: [id])
  nome        String
  valorAdicional Decimal @db.Decimal(10, 2)
  obrigatoria Boolean  @default(false)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Adicional {
  id          String   @id @default(cuid())
  produtoId   String
  produto     Produto  @relation(fields: [produtoId], references: [id])
  nome        String
  valor       Decimal  @db.Decimal(10, 2)
  maximoPermitido Int? 
  obrigatorio Boolean  @default(false)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Combo {
  id              String   @id @default(cuid())
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  nome            String
  descricao       String?
  precoFixo       Decimal  @db.Decimal(10, 2)
  permitirSubstituicao Boolean @default(false)
  ativo           Boolean  @default(true)
  itens           ComboItem[]
  createdAt       DateTime @default(now())
}

model ComboItem {
  id        String  @id @default(cuid())
  comboId   String
  combo     Combo   @relation(fields: [comboId], references: [id])
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])
}

model Pedido {
  id              String        @id @default(cuid())
  clienteId       String
  cliente         Cliente       @relation(fields: [clienteId], references: [id])
  status          StatusPedido  @default(aberto)
  total           Decimal       @db.Decimal(10, 2)
  valorDesconto   Decimal?      @db.Decimal(10, 2)
  formaEntrega    FormaEntrega
  enderecoEntrega Json?
  itens           ItemPedido[]
  pagamento       Pagamento?
  createdAt       DateTime      @default(now())
  estabelecimentoId String?
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
  cupomId         String?
  cupom           Cupom?        @relation(fields: [cupomId], references: [id])
  cuponsUsos      CupomUso[]
}

model ItemPedido {
  id          String   @id @default(cuid())
  pedidoId    String
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId   String
  produto     Produto  @relation(fields: [produtoId], references: [id])
  quantidade  Int
  adicionais  Json?
  observacoes String?
  subtotal    Decimal  @db.Decimal(10, 2)
}

model Pagamento {
  id        String   @id @default(cuid())
  pedidoId  String   @unique
  pedido    Pedido   @relation(fields: [pedidoId], references: [id])
  tipo      String
  valor     Decimal  @db.Decimal(10, 2)
  status    String
  txid      String?
  qrcode    String?
  createdAt DateTime @default(now())
}

model Configuracao {
  id            Int      @id @default(1)
  taxaEntrega   Decimal? @db.Decimal(10, 2)
  tempoEstimado Int?
  pixApiKey     String?
  pixChave      String?
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  role         Role     @default(ADMIN_ESTABELECIMENTO)
  estabelecimentoId String?
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
}

model LogSistema {
  id        String   @id @default(cuid())
  tipo      String
  mensagem  String
  criadoEm  DateTime @default(now())
}
 
model ConfiguracaoAcaiteria {
  id               String @id @default(cuid())
  estabelecimentoId String @unique
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  minSabores       Int    @default(0)
  maxSabores       Int    @default(3)
  minSorvetes      Int    @default(0)
  maxSorvetes      Int    @default(2)
  minAcompanhamentos Int  @default(0)
  maxAcompanhamentos Int  @default(4)
  minCoberturas    Int    @default(0)
  maxCoberturas    Int    @default(2)
  minComplementos  Int    @default(0)
  maxComplementos  Int    @default(3)
}

model AcaiSabor {
  id                String @id @default(cuid())
  nome              String
  descricao         String?
  ativo             Boolean @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  createdAt         DateTime @default(now())
}

model AcaiSorvete {
  id                String @id @default(cuid())
  nome              String
  ativo             Boolean @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  createdAt         DateTime @default(now())
}

model AcaiAcompanhamento {
  id                String @id @default(cuid())
  nome              String
  ativo             Boolean @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  createdAt         DateTime @default(now())
}

model AcaiCobertura {
  id                String @id @default(cuid())
  nome              String
  ativo             Boolean @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  createdAt         DateTime @default(now())
}

model AcaiComplemento {
  id                String @id @default(cuid())
  nome              String
  valorAdicional    Decimal @db.Decimal(10, 2)
  ativo             Boolean @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  createdAt         DateTime @default(now())
}

model ConfiguracaoPizzaria {
  id                String @id @default(cuid())
  estabelecimentoId String @unique
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  maxSaboresPorPizza Int @default(2)
}

model PizzaTamanho {
  id                String @id @default(cuid())
  nome              String
  precoBase         Decimal @db.Decimal(10, 2)
  ativo             Boolean @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  createdAt         DateTime @default(now())
}

model PizzaSabor {
  id                String @id @default(cuid())
  nome              String
  descricao         String?
  ativo             Boolean @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  createdAt         DateTime @default(now())
}
enum StatusPedido {
  aberto
  aguardando_pix
  pago
  preparando
  saiu_para_entrega
  entregue
  cancelado
}

enum FormaEntrega {
  entrega
  retirada
}

enum TipoCupom {
  PERCENTUAL
  VALOR_FIXO
  FRETE_GRATIS
}

model Cupom {
  id                String   @id @default(cuid())
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  codigo            String
  descricao         String?
  tipo              TipoCupom
  valor             Decimal  @db.Decimal(10, 2)
  valorMinimoPedido Decimal? @db.Decimal(10, 2)
  limiteTotalUso    Int?
  limitePorCliente  Int?
  dataInicio        DateTime
  dataFim           DateTime
  ativo             Boolean  @default(true)
  usos              CupomUso[]
  pedidos           Pedido[]
  createdAt         DateTime @default(now())

  @@unique([estabelecimentoId, codigo])
}

model CupomUso {
  id        String   @id @default(cuid())
  cupomId   String
  cupom     Cupom    @relation(fields: [cupomId], references: [id])
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id])
  usedAt    DateTime @default(now())
}
